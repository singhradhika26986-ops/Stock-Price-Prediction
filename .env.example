APP_NAME=Stock Price Prediction API
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_PERIOD=5y
DEFAULT_INTERVAL=1d
MODEL_DIR=models
DATA_DIR=data
LOG_DIR=logs
MONITORING_DIR=monitoring
FORECAST_HORIZON=5
SEQUENCE_LENGTH=20
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_API_BASE_URL=http://localhost:8000
API_KEY=change-me
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_SCHEDULER=true
RETRAIN_INTERVAL_MINUTES=360
SCHEDULED_TICKERS=AAPL,MSFT,GOOGL
DEFAULT_LIVE_LOOKBACK_PERIOD=1mo
